# ==============================================================================
# Code Lore - Environment Configuration Template
# Copy this file to .env and customize for your target deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Profile
# ------------------------------------------------------------------------------
# Target environment: development | testing | production | staging
ENVIRONMENT=development

# Application name shown in Swagger docs and root endpoints
APP_NAME=Code Lore - Code Explanation Engine

# Debug mode (automatically False in production)
DEBUG=true

# API version prefix
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. Server Binding & Networking
# ------------------------------------------------------------------------------
# Host interface for backend (0.0.0.0 for Docker containers, 127.0.0.1 for local)
BACKEND_HOST=0.0.0.0

# Backend port
BACKEND_PORT=8000

# Streamlit frontend port
FRONTEND_PORT=8501

# Number of uvicorn worker processes in production
WORKERS=2

# Explicit backend URL accessible to frontend clients (useful in Docker/Kubernetes)
# Example for Docker Compose: http://codelore-backend:8000/api/v1
# Example for Localhost:      http://127.0.0.1:8000/api/v1
BACKEND_URL=

# ------------------------------------------------------------------------------
# 3. Database Persistence & Migrations
# ------------------------------------------------------------------------------
# SQLite database path (or PostgreSQL / MySQL connection string)
# Local / Container default: sqlite:///./data/app.db
# In-memory test default:    sqlite:///:memory:
DATABASE_URL=sqlite:///./data/app.db

# ------------------------------------------------------------------------------
# 4. Structured Logging Configuration
# ------------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log output format: text (human-readable for dev) | json (single-line JSON for prod)
LOG_FORMAT=text

# ------------------------------------------------------------------------------
# 5. LLM Synthesis Providers
# ------------------------------------------------------------------------------
# Selected provider: mock (zero-cost offline testing) | openai | gemini
LLM_PROVIDER=mock

# OpenAI API credentials (required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API credentials (required only when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 6. RAG Semantic Search & Vector Embeddings
# ------------------------------------------------------------------------------
# Embedding provider: fastembed (local offline ONNX) | openai | mock
EMBEDDING_PROVIDER=fastembed

# ------------------------------------------------------------------------------
# 7. Security, Authentication & CORS
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing sessions and JWT tokens
# CRITICAL: Replace with a secure 32+ character random secret in production!
# e.g., openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_production_secret_key_32_chars

# Allowed CORS origins (comma-separated URLs or JSON array)
# e.g., https://codelore.yourdomain.com,https://api.yourdomain.com
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5001,http://127.0.0.1:5001

# Enable rate limiting on expensive explanation and trace routes
RATE_LIMITING_ENABLED=true

# ------------------------------------------------------------------------------
# 8. AST Parser Limits & Tree-sitter
# ------------------------------------------------------------------------------
# Maximum submitted code length in characters (default 50,000)
MAX_CODE_LENGTH=50000

# Enable Tree-sitter multi-language concrete syntax tree parser
ENABLE_TREE_SITTER=true
